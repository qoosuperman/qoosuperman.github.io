---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const experience = [
  {
    role: 'Senior Backend Engineer',
    org: 'Hahow 好學校',
    period: '2024.04 – 現在',
  },
  {
    role: 'Backend Engineer',
    org: 'Hahow 好學校',
    period: '2022.05 – 2024.05',
  },
  {
    role: 'Server Engineer',
    org: 'Akatsuki Taiwan Inc. 曉數碼',
    period: '2019.12 – 2022.06',
  },
  {
    role: 'Process Engineer',
    org: '台灣積體電路製造股份有限公司',
    period: '2015 – 2019',
  },
];

const education = [
  { degree: 'M.S. in Chemical Engineering', period: '2013 – 2015' },
  { degree: 'B.S. in Chemical Engineering', period: '2009 – 2013' },
];
---

<BaseLayout title="About" description="About Anthony Chao">
  <PageHeader title="About me" />

  <div class="prose prose-neutral max-w-none">
    <p>我是 Anthony。目前在 Hahow 好學校擔任 Senior Backend Engineer。</p>
    <p>
      主要專業在 Ruby on Rails 的服務開發，以及 AWS 與 Kubernetes
      上的基礎設施。從高流量的遊戲後端，到面向企業客戶的 B2B
      產品，累積了在不同規模與情境下開發及維運服務的經驗。
    </p>
    <p>
      這個部落格記錄我在工作中的學習與思考，主題大多圍繞 Rails、DevOps、軟體開發實務還有一些生活大小事。
    </p>
  </div>

  <section class="mt-16">
    <h2 class="text-xl font-bold">經歷</h2>
    <ul class="mt-6 space-y-6">
      {experience.map((job) => (
        <li>
          <h3 class="font-semibold">{job.role}</h3>
          <p class="mt-1 text-sm text-neutral-500">
            {job.org}
            <span class="mx-2 text-neutral-300">·</span>
            {job.period}
          </p>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-16">
    <h2 class="text-xl font-bold">學歷</h2>
    <ul class="mt-6 space-y-4">
      {education.map((item) => (
        <li>
          <h3 class="font-semibold">{item.degree}</h3>
          <p class="mt-1 text-sm text-neutral-500">{item.period}</p>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
