---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = await getCollection('posts');

const counts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags ?? []) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}

// most-used first, alphabetical within the same count so the order is stable
const tags = [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<BaseLayout title="Tags" description="All tags">
  <h1 class="text-2xl font-bold">Tags</h1>
  <p class="mt-2 text-sm text-neutral-500">{tags.length} 個標籤</p>

  <ul class="mt-10 flex flex-wrap gap-3">
    {tags.map(([tag, count]) => (
      <li>
        <a
          href={`/tags/${tag}/`}
          class="inline-flex items-baseline gap-2 rounded-full border border-neutral-200 px-4 py-2 text-sm hover:border-neutral-400"
        >
          {tag}
          <span class="text-xs text-neutral-400">{count}</span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
