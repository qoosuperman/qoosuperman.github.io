---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

// posts are already newest-first, so each year's bucket keeps that order
// and the years themselves come out descending
const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.date.getFullYear();
  const bucket = byYear.get(year);
  if (bucket) bucket.push(post);
  else byYear.set(year, [post]);
}

const monthDay = (d: Date) =>
  `${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
---

<BaseLayout title="Archive" description="All posts by year">
  <PageHeader title="Archive" meta={`${posts.length} 篇文章`} />

  {[...byYear].map(([year, yearPosts]) => (
    <section class="mt-12">
      <h2 class="text-lg font-semibold text-neutral-400">{year}</h2>
      <ul class="mt-4 space-y-2">
        {yearPosts.map((post) => (
          <li class="flex gap-4">
            <time
              datetime={post.data.date.toISOString()}
              class="shrink-0 font-mono text-sm text-neutral-500 tabular-nums"
            >
              {monthDay(post.data.date)}
            </time>
            <a href={`/article/${post.id}/`} class="hover:underline">
              {post.data.title}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>
